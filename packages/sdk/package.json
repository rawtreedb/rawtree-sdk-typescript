{
  "name": "@rawtree/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for building apps with RawTree.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "openapi-ts"
  },
  "keywords": [
    "rawtree",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawtreedb/rawtree-sdk-typescript.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/rawtreedb/rawtree-sdk-typescript/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/rawtreedb/rawtree-sdk-typescript/issues"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0"
  }
}
